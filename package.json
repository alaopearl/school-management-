{
  "name": "student-management",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for student management frontend and backend",
  "main": "server.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm --workspace backend run dev\" \"npm --workspace frontend run dev\"",
    "build": "npm --workspace frontend run build"
  },
  "keywords": [
    "student",
    "education",
    "backend",
    "frontend",
    "render"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
