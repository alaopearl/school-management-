# Root application environment variables
PORT=5000
DATABASE_PATH=./students.db
JWT_SECRET=replace-with-your-secret
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Optional email settings for OTP delivery and support ticket delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=School Admin <no-reply@example.com>

# Support-ticket recipient address (used when no school-specific support email is configured)
SUPPORT_EMAIL=student.management.website01@gmail.com

# Optional Gmail app password fallback when SMTP is not configured
GMAIL_APP_PASSWORD=your-gmail-app-password

# Platform super-admin bootstrap credentials
SUPER_ADMIN_EMAIL=school.management.website01@gmail.com
SUPER_ADMIN_PASSWORD=Pearlman11..
SUPER_ADMIN_NAME=Platform Super Admin

# Optional upload provider for image storage. When set, uploads go to Cloudinary.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
